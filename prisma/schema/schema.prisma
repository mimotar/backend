generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id                        Int                 @id @default(autoincrement())
  title                     String              @default("") @db.VarChar(200)
  amount                    Int
  user_id                   Int?
  additional_agreement      String?              @db.VarChar(200)
  creator_fullname          String
  creator_email             String
  creator_no                String
  creator_address           String?
  receiver_fullname         String
  receiver_no               String
  receiver_address          String?
  link_expires              Boolean             @default(false)
  txn_link                  String
  created_at                DateTime            @default(now())
  inspection_duration       Int
  reciever_role             Role
  terms                     String?
  transactionType           TransactionType
  transaction_description   String              @db.VarChar(200)
  pay_escrow_fee            EscrowFeePayer
  pay_shipping_cost         EscrowFeePayer?
  creator_role              Role
  status                    StatusEnum          @default(CREATED)
  expiresAt                 DateTime
  transactionToken          String              @unique
  reciever_email            String
  approveStatus             Boolean             @default(false)
  rejection_reason          String?
  files                     Json?               @db.Json
  otp                       String?
  otp_created_at            DateTime?
  payment_id                Int?
  currency                  CurrencyEnum        @default(NGN)
  agreement_accepted_at     DateTime?
  payment_sent_to_escrow_at DateTime?
  inspection_started_at     DateTime?
  inspection_completed_at   DateTime?
  transaction_completed_at  DateTime?
  deadline                  DateTime
  deadlineExtensions        DeadlineExtension[]
  dispute                   Dispute[]
  earnings                  Earnings[]
  payment                   Payment?
  user                      User?               @relation(fields: [user_id], references: [id])
  milestones                Milestone[]
}

model Milestone {
  id                 Int                 @id @default(autoincrement())
  transaction_id     Int
  sequence           Int
  name               String
  amount             Int
  deadline           DateTime
  files              Json?               @db.Json
  status             StatusEnum          @default(CREATED)
  activatedAt        DateTime?
  completedAt        DateTime?
  releasedAt         DateTime?
  deadlineExtensions DeadlineExtension[]
  disputes           Dispute[]
  earnings           Earnings?
  transaction        Transaction         @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@unique([transaction_id, sequence])
  @@index([transaction_id, status])
}

model Payment {
  id                    Int           @id @default(autoincrement())
  transaction_id        Int           @unique
  transaction_reference String        @unique
  amount                Int
  payment_method        PaymentMethod @default(ATM_CARD)
  status                PaymentStatus @default(PENDING)
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
  title                 String        @db.VarChar(200)
  transaction           Transaction   @relation(fields: [transaction_id], references: [id])
}

model User {
  id                  Int                 @id @default(autoincrement())
  email               String              @unique
  password            String
  createdAt           DateTime            @default(now())
  verified            Boolean             @default(false)
  verificationToken   String?
  firstName           String
  middleName          String?
  lastName            String
  sureName            String
  provider            String?
  subject             String?
  otp                 String?
  otpCreatedAt        DateTime?
  otpPurpose          OtpPurpose?
  pendingPasswordHash String?
  totalEarnings       Decimal             @default(0) @db.Decimal(19, 2)
  walletBalance       Decimal             @default(0) @db.Decimal(19, 2)
  walletBalanceNGN    Decimal             @default(0) @db.Decimal(19, 2)
  totalEarningsNGN    Decimal             @default(0) @db.Decimal(19, 2)
  walletBalanceUSD    Decimal             @default(0) @db.Decimal(19, 2)
  totalEarningsUSD    Decimal             @default(0) @db.Decimal(19, 2)
  chats               ChatrParticipants[]
  disputesAsBuyer     Dispute[]           @relation("DisputeBuyer")
  disputesCreated     Dispute[]           @relation("DisputeCreator")
  disputesAsSeller    Dispute[]           @relation("DisputeSeller")
  disputesResolved    Dispute[]           @relation("DisputeResolver")
  earnings            Earnings[]
  messages            Message[]
  notification        Notification[]
  profile             Profile?
  setting             Setting?
  transaction         Transaction[]
  walletTransactions  WalletTransaction[]
  deadlineExtensions  DeadlineExtension[]
  bankAccountDetails  BankAccountDetail[]
  userKYC             UserKYC?
}


model UserKYC {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  isVerified         Boolean   @default(false)
  kycDocumentType   String?
  kycDocumentNumber String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}
model DeadlineExtension {
  id               Int         @id @default(autoincrement())
  transactionId    Int
  milestoneId      Int?
  previousDeadline DateTime
  newDeadline      DateTime
  reason           String?     @db.VarChar(500)
  extendedById     Int
  createdAt        DateTime    @default(now())
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  milestone        Milestone?  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  extendedBy       User        @relation(fields: [extendedById], references: [id], onDelete: Restrict)

  @@index([transactionId, createdAt])
  @@index([milestoneId, createdAt])
  @@index([extendedById])
}

model Earnings {
  id             Int            @id @default(autoincrement())
  userId         Int
  amount         Decimal        @db.Decimal(19, 2)
  createdAt      DateTime       @default(now())
  description    String?
  transaction_id Int
  milestone_id   Int?           @unique
  releaseKey     String         @unique
  status         EarningsStatus @default(PENDING)
  transaction    Transaction    @relation(fields: [transaction_id], references: [id])
  milestone      Milestone?     @relation(fields: [milestone_id], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@index([transaction_id])
}

model WalletTransaction {
  id          Int                   @id @default(autoincrement())
  userId      Int
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(19, 2)
  description String?
  currency    CurrencyEnum          @default(NGN)
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id])
}

model Dispute {
  id               Int                @id @default(autoincrement())
  transactionId    Int
  milestoneId      Int?
  chatId           Int?               @unique
  description      String
  resolutionOption ResolutionOption
  createdAt        DateTime?          @default(now())
  elapsesAt        DateTime?
  status           disputeStatus      @default(ongoing)
  resolution       DisputeResolution?
  resolvedAt       DateTime?
  resolvedById     Int?
  reason           String
  evidenceUrl      String[]
  evidenceId       String[]
  buyerId          Int
  creatorId        Int
  sellerId         Int
  buyer            User               @relation("DisputeBuyer", fields: [buyerId], references: [id])
  chat             Chat?              @relation(fields: [chatId], references: [id])
  creator          User               @relation("DisputeCreator", fields: [creatorId], references: [id])
  resolver         User?              @relation("DisputeResolver", fields: [resolvedById], references: [id])
  seller           User               @relation("DisputeSeller", fields: [sellerId], references: [id])
  milestone        Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  transaction      Transaction        @relation(fields: [transactionId], references: [id])

  @@index([transactionId, status])
  @@index([milestoneId, status])
}

model Chat {
  id           Int                 @id @default(autoincrement())
  content      String
  timestamp    DateTime            @default(now())
  participants ChatrParticipants[]
  dispute      Dispute?
  messages     Message[]
}

model ChatrParticipants {
  id     Int      @id @default(autoincrement())
  userId Int
  chatId Int
  role   ChatRole @default(USER)
  chat   Chat     @relation(fields: [chatId], references: [id])
  user   User     @relation(fields: [userId], references: [id])

  @@unique([userId, chatId])
  @@index([chatId])
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  senderId  Int
  content   String?
  fileUrl   String?
  fileType  String?
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([chatId])
}

model Profile {
  id                Int     @id @default(autoincrement())
  address           String?
  phone_no          String?
  avatar            String?
  bio               String? @db.VarChar(100)
  verification_no   String?
  verification_type String?
  next_kin          String?
  next_email        String?
  next_no           String?
  user_id           Int     @unique
  city              String?
  country           String?
  id_number         String?
  postal_code       String?
  user              User    @relation(fields: [user_id], references: [id])
}

model Setting {
  user_id                Int                    @unique
  id                     Int                    @id @default(autoincrement())
  defaultCurrency        DefaultCurrency        @default(NGN)
  notificationPreference NotificationPreference @default(EMAIL)
  twoFactorAuth          Boolean                @default(false)
  accountStatus          AccountStatus?         @default(ACTIVE)
  securityQuestions      Json
  user                   User                   @relation(fields: [user_id], references: [id])
}

model Notification {
  id               Int      @id @default(autoincrement())
  title            String
  sender_user_id   Int?
  receiver_user_id Int
  timestamp        DateTime @default(now())
  content          String?
  link             String?
  avatar           String
  read             Read     @default(unread)
  user             User?    @relation(fields: [sender_user_id], references: [id])
}

model Contact {
  id        Int      @id @default(autoincrement())
  email     String
  name      String
  message   String   @db.VarChar(300)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([name])
  @@index([message])
  @@index([createdAt])
  @@index([updatedAt])
}

model BankAccountDetail {
  id            Int      @id @default(autoincrement())
  userId       Int      @unique
  bankName     String
  bankCode      String
  accountName  String
  accountNumber String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@unique([bankCode, accountNumber, userId])
}

enum EscrowFeePayer {
  CLIENT
  FREELANCER
  BOTH
}

enum Role {
  CLIENT
  FREELANCER
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  CHANGE_PASSWORD
}

enum TransactionType {
  PHYSICAL_PRODUCT
  ONLINE_PRODUCT
  SERVICE
  RENTAL
  MILESTONE_BASED_PROJECT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum StatusEnum {
  CREATED
  APPROVED
  ONGOING
  COMPLETED
  DISPUTE
  REJECTED
  CANCELED
  EXPIRED
  PENDING_CLOSURE
}

enum PaymentMethod {
  BANK_TRANSFER
  ATM_CARD
  INTERNET_BANKING
  APPLE_PAY
  GOOGLE_PAY
  USSD
}

enum CurrencyEnum {
  USD
  GBP
  NGN
  GHS
  KES
  RWF
}

enum WalletTransactionType {
  INFLOW
  OUTFLOW
}

enum ResolutionOption {
  REFUND_ONLY
  REPLACEMENT_ONLY
  REFUND_OR_REPLACEMENT
  PARTIAL_REPAYMENT
  RESEND_PRODUCT
  REPEAT_SERVICE
  CANCEL_TRANSACTION
  OTHERS
}

enum disputeStatus {
  ongoing
  cancel
  closed
}

enum DisputeResolution {
  RELEASE_TO_SELLER
}

enum ChatRole {
  USER
  ADMIN
}

enum DefaultCurrency {
  GBP
  USD
  NGN
}

enum NotificationPreference {
  SMS
  EMAIL
  BOTH
}

enum AccountStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum Read {
  read
  unread
}

enum EarningsStatus {
  PENDING
  COMPLETED
  WITHDRAWN
  REVERSED
}
